# Copy to .env.local for local development. Never commit a filled-in copy:
# .gitignore blocks .env and .env.*, and this repository is public.
#
# With none of these set, the app runs on the in-memory demo store — no
# database, passwordless sign-in, open simulator. Setting the Supabase three
# switches it to real data and closes both of those doors automatically.

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Publishable ("anon") key. Safe to expose; RLS denies it everything.
SUPABASE_PUBLISHABLE_KEY=

# Secret ("service_role") key. Full read/write on every table, bypassing RLS.
# Server-side only. Never inline it into a build and never paste it anywhere
# it will be stored — a chat log, an issue, a commit.
SUPABASE_SECRET_KEY=

# Secret ingredient mixed in before a buyer's identifier is fingerprinted, so
# that a stolen redemptions table cannot be matched against a list of common
# email addresses. Any long random value: `openssl rand -hex 32`.
#
# Set it once, before real redemptions exist, and then leave it alone.
# Changing it invalidates every fingerprint stored under the old value, and
# returning buyers silently start reading as new customers.
#
# Unset, the app falls back to a pepper that is published in this repository
# and warns on boot in production. Fine locally, not fine in production.
CUSTOMER_REF_PEPPER=

# Force a mode instead of inferring it from whether Supabase is configured.
# "true" = demo store, "false" = require the database. Leave unset normally.
DEMO_MODE=
